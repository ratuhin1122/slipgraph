# Copy to .env for optional overrides. Compose generates random local DB/Redis
# credentials in the credential volumes; no password is required here.
API_PORT=8080
WEB_PORT=5173
LOG_LEVEL=info
# For running Go processes outside Compose (use your own credentials):
# DATABASE_URL=postgres://slipgraph_app:REPLACE_ME@localhost:5432/slipgraph?sslmode=require
# REDIS_URL=redis://:REPLACE_ME@localhost:6379/0
# APP_ENV=production
# HTTP_ADDR=:8080
# DB_PASSWORD_FILE=/run/secrets/app_password
# REDIS_PASSWORD_FILE=/run/secrets/redis_password
# Compose uses an isolated local network and sslmode=disable. Production requires TLS.

# Browser origin must exactly match unsafe request Origin headers.
PUBLIC_ORIGIN=http://localhost:5173
# Compose nginx overwrites X-Real-IP; direct deployments should leave this empty.
# TRUSTED_PROXY_HOST=web
# AUTH_KEY_FILE=/run/secrets/auth_key
# Auth key file contains 64 hexadecimal characters from a cryptographic RNG.

# Opt-in agent workflows. Use mock for the offline signature demo. Keys remain worker-only.
LLM_PROVIDER=disabled
LLM_MODEL=
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
LLM_DAILY_TOKENS=100000
LLM_DAILY_COST_MICROUSD=1000000
# Required when enabled: conservative rounded-up micro-USD/token rates for your model.
LLM_INPUT_MICROUSD_PER_TOKEN=
LLM_OUTPUT_MICROUSD_PER_TOKEN=

# Meetings: opt in with mock (offline) or openai. API and worker share the mode.
TRANSCRIPTION_PROVIDER=disabled
TRANSCRIPTION_MODEL=
# json gives a whole-recording timestamp/unknown speaker; diarized_json requires a compatible model.
TRANSCRIPTION_FORMAT=json
MEETING_DAILY_MINUTES=600
# MEDIA_ROOT must be an absolute private directory for non-Compose deployments.

# Worker-only embeddings: disabled, mock (hashed word counts), or openai.
EMBEDDING_PROVIDER=disabled
EMBEDDING_MODEL=
SEARCH_DAILY_TOKENS=1000000

# Optional GitHub OAuth app; public repositories only, no requested scopes.
# Callback: PUBLIC_ORIGIN/api/integrations/github/callback
# Independent 32-byte AES-GCM key as 64 hex characters. Keep stable and back up securely.
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
GITHUB_ENCRYPTION_KEY=
# Alternatively use GITHUB_CLIENT_ID_FILE, GITHUB_CLIENT_SECRET_FILE, GITHUB_ENCRYPTION_KEY_FILE.
