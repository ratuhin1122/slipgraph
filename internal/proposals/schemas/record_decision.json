{
  "type": "object",
  "additionalProperties": false,
  "required": [
    "title",
    "details",
    "evidence"
  ],
  "properties": {
    "title": {
      "type": "string",
      "minLength": 1,
      "maxLength": 200
    },
    "details": {
      "type": "string",
      "maxLength": 4000
    },
    "evidence": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "segment_id",
        "start_ms",
        "end_ms",
        "quote"
      ],
      "properties": {
        "segment_id": {
          "type": "string",
          "format": "uuid"
        },
        "start_ms": {
          "type": "integer",
          "minimum": 0
        },
        "end_ms": {
          "type": "integer",
          "minimum": 1
        },
        "quote": {
          "type": "string",
          "minLength": 1,
          "maxLength": 1000
        }
      }
    }
  }
}
