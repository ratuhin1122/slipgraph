{
  "type": "object",
  "additionalProperties": false,
  "required": [
    "name",
    "description",
    "start",
    "launch_due",
    "tasks",
    "dependencies"
  ],
  "properties": {
    "name": {
      "type": "string",
      "minLength": 1,
      "maxLength": 200
    },
    "description": {
      "type": "string",
      "maxLength": 4000
    },
    "start": {
      "type": "string",
      "format": "date-time"
    },
    "launch_due": {
      "anyOf": [
        {
          "type": "string",
          "format": "date-time"
        },
        {
          "type": "null"
        }
      ]
    },
    "tasks": {
      "type": "array",
      "minItems": 1,
      "maxItems": 20,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "title",
          "description",
          "start",
          "due",
          "estimate_minutes",
          "milestone",
          "key"
        ],
        "properties": {
          "title": {
            "type": "string",
            "minLength": 1,
            "maxLength": 200
          },
          "description": {
            "type": "string",
            "maxLength": 4000
          },
          "start": {
            "type": "string",
            "format": "date-time"
          },
          "due": {
            "type": "string",
            "format": "date-time"
          },
          "estimate_minutes": {
            "type": "integer",
            "minimum": 0,
            "maximum": 5256000
          },
          "milestone": {
            "type": "boolean"
          },
          "key": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9_]{0,31}$"
          }
        }
      }
    },
    "dependencies": {
      "type": "array",
      "maxItems": 60,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "task_key",
          "blocker_key"
        ],
        "properties": {
          "task_key": {
            "type": "string"
          },
          "blocker_key": {
            "type": "string"
          }
        }
      }
    }
  }
}
